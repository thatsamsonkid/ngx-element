{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-element": {
      "projectType": "library",
      "root": "projects/ngx-element",
      "sourceRoot": "projects/ngx-element/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-element/tsconfig.lib.json",
            "project": "projects/ngx-element/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-element/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-element/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-element/tsconfig.spec.json",
            "buildTarget": "ngx-element:build:development"
          }
        }
      }
    },
    "ngx-element-app": {
      "projectType": "application",
      "root": "projects/ngx-element-app",
      "sourceRoot": "projects/ngx-element-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ngx-element-app/src/main.ts",
            "outputPath": "dist/ngx-element-app",
            "index": "projects/ngx-element-app/src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/ngx-element-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ngx-element-app/src/assets",
                "output": "/assets"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/ngx-element-app/src",
                "output": "/"
              }
            ],
            "styles": [
              "projects/ngx-element-app/src/styles.scss"
            ],
            "scripts": [
              "projects/ngx-element-app/src/js/pure-externals.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/ngx-element-app/src/environments/environment.ts",
                  "with": "projects/ngx-element-app/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngx-element-app:build:production"
            },
            "development": {
              "buildTarget": "ngx-element-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-element-app/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
